{
  "name": "mailflow-backend",
  "version": "1.0.0",
  "description": "Mailflow API and SMTP server",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "nodemon index.js",
    "db:init": "psql -h ${DB_HOST:-localhost} -p ${DB_PORT:-5432} -U ${DB_USER:-mailflow} -d ${DB_NAME:-mailflow} -f schema/01_init.sql"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "mailparser": "^3.9.1",
    "nodemon": "^3.1.11",
    "pg": "^8.13.1",
    "smtp-server": "^3.18.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/smtp-server": "^3.5.12"
  }
}
